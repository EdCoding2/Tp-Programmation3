{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(Windows) Exécuter",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/program.exe",
      "args": ["main.c", "-f", "fichier", "-s"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/",
      "environment": [],
      "logging": {
        "moduleLoad": false
      },
      "preLaunchTask": "(Windows) Compiler"
    },
    {
      "name": "(MacOS) Exécuter",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/program",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/",
      "environment": [],
      "MIMode": "lldb",
      "targetArchitecture": "arm64",
      "logging": {
        "moduleLoad": false
      },
      "preLaunchTask": "(MacOS) Compiler"
    },
    {
      "name": "(Linux) Exécuter",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/program",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/",
      "environment": [],
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Pretty-printing pour GDB",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "moduleLoad": false
      },
      "preLaunchTask": "(Linux) Compiler"
    }    
  ]
}
