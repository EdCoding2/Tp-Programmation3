{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cppbuild",
      "label": "(Windows) Compiler",
      "command": "cl.exe",
      "args": [
        "/std:c17",
        "/Z7",
        "/EHsc",
        "/nologo",
        "/Fe${workspaceFolder}/build/program.exe",
        "/Fo${workspaceFolder}/build/",
        "${workspaceFolder}/src/main.c"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build"
      },
      "detail": "Compilation Windows"
    },
    {
      "type": "cppbuild",
      "label": "(MacOS) Compiler",
      "command": "/usr/bin/gcc",
      "args": [
        "-std=c17",
        "-g",
        "${workspaceFolder}/src/main.c",
        "-o",
        "${workspaceFolder}/build/program"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build"
      },
      "detail": "Compilation MacOS"
    },
    {
      "type": "cppbuild",
      "label": "(Linux) Compiler",
      "command": "/usr/bin/gcc",
      "args": [
        "-std=c17",
        "-fdiagnostics-color=always",
        "-g",
        "${workspaceFolder}/src/main.c",
        "-o",
        "${workspaceFolder}/build/program"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build"
      },
      "detail": "Compilation Linux"
    },
    {
      "type": "cppbuild",
      "label": "C/C++: cl.exe build active file",
      "command": "cl.exe",
      "args": [
        "/Zi",
        "/EHsc",
        "/nologo",
        "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Task generated by Debugger."
    }
  ]
}